{
  "cli": {
    "version": ">= 22.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "internal": {
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "applicationId": "com.raktsetusmu.app",
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "alpha": {
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "applicationId": "com.raktsetusmu.app",
        "track": "alpha",
        "releaseStatus": "completed"
      }
    },
    "production": {
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "applicationId": "com.raktsetusmu.app",
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
